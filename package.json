{
  "name": "dsh-slothy-model-picker",
  "version": "1.3.0",
  "type": "module",
  "main": "lib/index.js",
  "description": "Slothy-style model picker for the DeepSeek Harness Web GUI: provider-grouped model list and reasoning-effort slider with customizable appearance.",
  "license": "MIT",
  "author": "Mzys521",
  "homepage": "https://github.com/Mzys521/dsh-slothy-model-picker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mzys521/dsh-slothy-model-picker.git"
  },
  "bugs": {
    "url": "https://github.com/Mzys521/dsh-slothy-model-picker/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-picker",
    "reasoning-effort",
    "web-ui"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
